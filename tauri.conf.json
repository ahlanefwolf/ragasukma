{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ragasukma",
  "version": "0.1.1",
  "identifier": "com.ragasukma.assistant.overlay",
  "build": {
    "frontendDist": "ui"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2025 Ragasukma Team",
    "shortDescription": "AI Virtual Assistant Overlay",
    "resources": [
      "assets/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null,
        "installMode": "currentUser",
        "compression": "lzma",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": []
  }
}
