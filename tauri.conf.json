{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ragasukma",
  "version": "0.1.0",
  "identifier": "com.ragasukma.assistant.overlay",
  "build": {
    "frontendDist": "ui"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "ragasukma-overlay",
        "label": "main",
        "url": "index.html",
        "width": 180,
        "height": 320,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "resizable": true,
        "skipTaskbar": true,
        "visible": true
      }
    ]
  }
}
