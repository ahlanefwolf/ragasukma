{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ragasukma",
  "version": "0.1.0",
  "identifier": "com.ragasukma.assistant.overlay",
  "build": {
    "frontendDist": "ui"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "assets/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Assistant Menu & Settings",
        "label": "assistant-menu",
        "url": "menu.html",
        "width": 380,
        "height": 620,
        "decorations": true,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": true
      },
      {
        "title": "ragasukma-overlay",
        "label": "main",
        "url": "index.html",
        "width": 180,
        "height": 320,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "resizable": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "title": "Skill Commands Manager",
        "label": "skills",
        "url": "skills.html",
        "width": 680,
        "height": 560,
        "decorations": true,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": false
      },
      {
        "title": "Assistant Settings",
        "label": "settings",
        "url": "settings.html",
        "width": 520,
        "height": 640,
        "decorations": true,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": false
      },
      {
        "title": "VRM Pose & Motion Tuner",
        "label": "pose-tuner",
        "url": "tuner.html",
        "width": 880,
        "height": 680,
        "decorations": true,
        "alwaysOnTop": false,
        "resizable": true,
        "visible": false
      },
      {
        "title": "Voice AI Session",
        "label": "anytospeech-session",
        "url": "about:blank",
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
        "width": 960,
        "height": 700,
        "decorations": true,
        "alwaysOnTop": false,
        "resizable": true,
        "visible": false
      }
    ]
  }
}
