{
  "manifest_version": 3,
  "name": "Ragasukma AI Web Companion",
  "version": "1.0.0",
  "description": "Jembatan ringan AI Voice Assistant untuk mengontrol dan membaca YouTube, YouTube Music, dan tab browser secara cerdas.",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "http://127.0.0.1:42128/*",
        "http://localhost:42128/*"
      ],
      "js": [
        "modules/click_engine.js",
        "modules/dom_extractor.js",
        "modules/input_engine.js",
        "modules/media_controller.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
