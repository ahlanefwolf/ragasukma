# ==============================================================================
# 🎀 AI-Voice: Desktop Assistant Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 👤 Karakter & Identitas Personal
# ------------------------------------------------------------------------------
# Nama karakter/asisten yang akan menemani (misal: "Laras", "Jessica", "Clara")
ASSISTANT_NAME=Laras

# Panggilan akrab dari asisten ke kamu (misal: "Mas", "Sayang", "Kak", "Boss")
USER_CALLSIGN=Mas

# ------------------------------------------------------------------------------
# 🌐 STT (Speech-to-Text) Engine
# ------------------------------------------------------------------------------
# Pilihan engine transkripsi suara:
# - "google" : Google Speech API (Gratis, tanpa API key, responsif, bahasa Indonesia)
# - "groq"   : Groq Cloud Whisper API (Ultra cepat ~0.3s, butuh GROQ_API_KEY)
STT_ENGINE=google
GROQ_API_KEY=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

# ------------------------------------------------------------------------------
# 🧠 LLM (Large Language Model)
# ------------------------------------------------------------------------------
# Endpoint OpenAI-compatible (Ollama, vLLM, OpenRouter, 9router, LMStudio, dll.)
LLM_BASE_URL=http://localhost:20128/v1
LLM_MODEL=ag/gemini-3.7-flash-low
LLM_API_KEY=sk-6193ecdf4d415f8e-95erfo-0eb6092b

# ------------------------------------------------------------------------------
# 🎤 Input Suara & VAD (Voice Activity Detection)
# ------------------------------------------------------------------------------
# Mode percakapan:
# - "auto"  : Hands-Free realtime (otomatis rekam saat berbicara)
# - "press" : Manual Push-to-Talk (tekan tombol spasi untuk bicara)
VOICE_MODE=auto

# Sensitivitas Mic (0 - 4 atau desimal manual):
# 0 = Sangat Rendah (Ruangan ramai / butuh suara keras)
# 1 = Rendah
# 2 = Normal / Standar
# 3 = Tinggi (Responsif / Suara santai & pelan)
# 4 = Ultra Sensitif (Bisikan / Mic jarak jauh)
MIC_SENSITIVITY=3

# Batas jeda hening sebelum rekaman otomatis diproses (0 - 4 atau hitungan chunk):
# 0 = ~300ms (Sangat Cepat)
# 1 = ~400ms (Cepat)
# 2 = ~500ms (Standar)
# 3 = ~650ms (Santai)
# 4 = ~875ms (Lambat)
VAD_SILENCE_LIMIT=2

# Level Noise Reduction DSP:
# 0 = Nonaktif (hanya hapus DC offset)
# 1 = Ringan (High-pass 120Hz + Noise gate halus)
# 2 = Sedang (High-pass 150Hz + Noise gate agresif)
NOISE_REDUCTION_LEVEL=0

# ------------------------------------------------------------------------------
# 🔊 TTS (Text-to-Speech) & Auto-Fallback
# ------------------------------------------------------------------------------
# Pilihan engine utama:
# - "google"      : Google Translate TTS (Gratis, cepat, stabil)
# - "kiki"        : KikiVoice.ai Voice Cloning (Web automation engine)
# - "anytospeech" : AnyToSpeech Web Engine
# - "elevenlabs"  : ElevenLabs API (Butuh API Key)
TTS_ENGINE=google

# API Key ElevenLabs (Opsional jika TTS_ENGINE=elevenlabs):
TTS_ELEVEN_LABS_KEY=sk_e6f39ca06500472258e303ac9deef92b91025820b44500dd
ELEVENLABS_VOICE_ID=pFZP5JQG7iQjIQuC4Bku

# Pengaturan Suara Google TTS:
# - TTS_SPEED : Kecepatan bicara (1.0 = Normal, 1.15 = Sedikit Cepat)
# - TTS_LANG  : Bahasa TTS (id = Indonesia, ja = Jepang, en = Inggris)
TTS_SPEED=1.15
TTS_LANG=id

# ------------------------------------------------------------------------------
# 🪟 Tampilan Desktop Overlay (Tauri v2)
# ------------------------------------------------------------------------------
# Tipe avatar di layar:
# - "vrm" : 3D VRM Three.js (Animasi tubuh interaktif, pose luwes, kedip & lip-sync)
# - "svg" : 2D Ilustrasi Vektor Statis (Hemat resource ekstrem)
AVATAR_TYPE=vrm
